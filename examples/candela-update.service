# /etc/systemd/system/candela-update.service
[Unit]
Description=Download the manufacturer data package and rebuild the database
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/candela
ExecStart=/opt/candela/.venv/bin/python etl/fetch_trilux.py --rebuild
TimeoutStartSec=3600
