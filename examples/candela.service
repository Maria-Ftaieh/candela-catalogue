# /etc/systemd/system/candela.service
[Unit]
Description=Candela product and document catalogue
After=network.target

[Service]
Type=exec
WorkingDirectory=/opt/candela
ExecStart=/opt/candela/.venv/bin/uvicorn web.app:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
