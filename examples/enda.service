# /etc/systemd/system/enda.service
[Unit]
Description=ENDA product and document catalogue
After=network.target

[Service]
Type=exec
WorkingDirectory=/opt/enda
ExecStart=/opt/enda/.venv/bin/uvicorn web.app:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
